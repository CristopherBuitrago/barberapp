PUERTO=3001

# --- Meta for Developers / WhatsApp Cloud API ---
# Panel de la app en developers.facebook.com > WhatsApp > Configuración de la API
WHATSAPP_TOKEN=token-de-acceso-permanente-del-usuario-del-sistema
WHATSAPP_PHONE_NUMBER_ID=id-del-numero-de-telefono
# Token que tú inventas y pegas en "Webhook > Verificar token" en Meta
WHATSAPP_VERIFY_TOKEN=inventa-un-token-de-verificacion
# Configuración de la app > Básica > Clave secreta de la app (valida la firma del webhook)
WHATSAPP_APP_SECRET=clave-secreta-de-la-app
GRAPH_API_VERSION=v23.0

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODELO=claude-opus-5-5
# low | medium | high (para chat de reservas "low" es suficiente y rápido)
CLAUDE_ESFUERZO=low

# --- Back de la barbería ---
BACK_URL=http://localhost:3000
# Igual a AGENTE_API_KEY del back
BACK_API_KEY=cambia-esta-clave-agente

# --- Barbería ---
BARBERIA_NOMBRE=Diego Barber
BARBERIA_DIRECCION=Calle 00 # 00-00, Medellín
# Número que recibe los avisos cuando un cliente pide hablar con una persona (sin "+")
BARBERIA_TELEFONO_AVISOS=573000000000
POLITICA_DATOS_URL=https://tu-dominio.com/politica-de-datos
DESCUENTO_REGISTRO_PCT=10
WEB_URL=http://localhost:5173

# Desfase horario respecto a UTC (Colombia)
ZONA_DESFASE=-05:00
# Horas sin mensajes tras las que la conversación arranca de cero
HORAS_SESION=6
# Habilita POST /simular para probar sin WhatsApp (nunca en producción)
SIMULADOR_ACTIVO=true
