# Conexión a PostgreSQL (ver docker-compose.yml en la raíz de personal/)
DATABASE_URL="postgresql://barberia:barberia@localhost:5433/barberia?schema=public"

PUERTO=3000
# Origen permitido para el front (CORS)
FRONT_ORIGEN=http://localhost:5173

# Desfase horario de la barbería respecto a UTC (Colombia no tiene horario de verano)
ZONA_DESFASE=-05:00
# Intervalo entre horas ofrecidas al cliente, en minutos
INTERVALO_MIN=30

# Clave que el agente de WhatsApp envía en el header x-api-key
AGENTE_API_KEY=cambia-esta-clave-agente

# Descuento para clientes que se registran en la plataforma (porcentaje, primera cita)
DESCUENTO_REGISTRO_PCT=10

# Con lo que se firman los JWT de sesión (mínimo 32 caracteres). En producción va como secreto
JWT_SECRET=cambia-esto-por-una-clave-larga-de-al-menos-32-caracteres
# Minutos sin actividad para que la sesión se cierre sola
SESION_MINUTOS=30
# true en producción: la cookie de sesión solo viaja por HTTPS
COOKIE_SECURE=false
