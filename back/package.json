{
  "name": "barberia-back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:api": "node --import tsx --test --test-concurrency=1 \"tests/api/**/*.test.ts\"",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "equipo:cuenta": "tsx scripts/team-account.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "cors": "^2.8.6",
    "dotenv": "^17.2.0",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@scarf/scarf": false
  }
}
